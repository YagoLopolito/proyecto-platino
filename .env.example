NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Requerida para conectar cuentas PSN. Generar con: openssl rand -base64 32
PSN_TOKEN_ENCRYPTION_KEY=

# Opcional: completa la carátula del juego cuando el ícono de PSN no alcanza.
RAWG_API_KEY=

# Opcional: fallback de carátula cuando RAWG no encuentra resultado.
STEAMGRIDDB_API_KEY=

# Requerida para el advisor con IA (lib/ai/) y la búsqueda de enlaces externos
# con IA (lib/external-guides/ai-search.ts). API key de Groq (console.groq.com),
# free tier sin tarjeta. Modelos: llama-3.3-70b-versatile (plan) y
# compound-beta-mini (búsqueda web nativa, restringida por dominio).
AI_PROVIDER_API_KEY=

# Requerida para conectar y sincronizar cuentas de Steam (lib/steam/); opcional
# para las guías: sin ella lib/external-guides/ no trae guías de Steam Community
# (la búsqueda en PowerPyx/PSNProfiles/TrueTrophies sigue funcionando igual).
# Gratis en steamcommunity.com/dev/apikey. Es la key de la app, no del usuario:
# no hay equivalente al NPSSO ni nada que expire.
STEAM_API_KEY=

# Requerida para el cron de sync periódico (/api/cron/sync). Vercel la manda
# sola como header Authorization si está seteada en el proyecto. Generar con:
# openssl rand -base64 32
CRON_SECRET=

# --- Testing E2E (Playwright) ---------------------------------------------
# Copiar estas junto con las de Supabase a .env.test.local (gitignoreado).
# Ver TESTING_PRD.md.

# Activa los mocks de PSN/Groq/RAWG/Steam en lib/**. Nunca setearla en Vercel.
E2E_MOCKS=1

# Opcional: URL contra la que corre el smoke (por defecto, localhost:3000).
PLAYWRIGHT_BASE_URL=

# Opcional: 1 para no borrar los datos de test al terminar (debug).
E2E_KEEP_DATA=

# Solo para `npm run e2e:live`: NPSSO real. Nunca commitear.
E2E_LIVE_NPSSO=
