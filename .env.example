NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Requerida para conectar cuentas PSN. Generar con: openssl rand -base64 32
PSN_TOKEN_ENCRYPTION_KEY=

# Opcional: completa la carátula del juego cuando el ícono de PSN no alcanza.
RAWG_API_KEY=

# Opcional: fallback de carátula cuando RAWG no encuentra resultado.
STEAMGRIDDB_API_KEY=

# Requerida para el advisor con IA (lib/ai/). API key de Anthropic (Claude).
AI_PROVIDER_API_KEY=

# Opcional: sin ella, lib/external-guides/ no trae guías de Steam Community
# (la búsqueda con IA en PowerPyx/PSNProfiles/TrueTrophies sigue funcionando
# igual). Gratis en steamcommunity.com/dev/apikey.
STEAM_API_KEY=

# Requerida para el cron de sync periódico (/api/cron/sync). Vercel la manda
# sola como header Authorization si está seteada en el proyecto. Generar con:
# openssl rand -base64 32
CRON_SECRET=
